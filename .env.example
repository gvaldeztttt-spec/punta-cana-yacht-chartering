# Public site URL — used for images and logos in quote emails
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Option A — Resend (recommended for websites; works when GoDaddy SMTP is blocked)
# Sign up at https://resend.com, verify puntacanayachtcharting.com, add DNS records in GoDaddy
RESEND_API_KEY=
RESEND_FROM=booking@puntacanayachtcharting.com

# Option B — GoDaddy Microsoft 365 SMTP (requires org + mailbox SMTP AUTH enabled)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=booking@puntacanayachtcharting.com
SMTP_PASS=
SMTP_FROM=booking@puntacanayachtcharting.com

# Where new quote notifications are sent
QUOTE_TO_EMAIL=booking@puntacanayachtcharting.com
